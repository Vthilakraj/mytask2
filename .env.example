# Server
PORT=3000

# Redis (used by BullMQ for the background email queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# SMTP / Transactional email configuration
# For providers like SendGrid, Mailgun, Postmark, AWS SES (SMTP interface), etc.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=replace-with-secret-from-secret-manager
EMAIL_FROM="Movie Bookings <no-reply@example.com>"

# Email queue retry configuration
EMAIL_MAX_RETRIES=5
EMAIL_RETRY_BACKOFF_MS=5000
