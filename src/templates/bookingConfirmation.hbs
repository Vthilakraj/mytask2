<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Booking Confirmation</title>
  </head>
  <body style="font-family: Arial, sans-serif; color: #222;">
    <h2>Booking Confirmed!</h2>
    <p>Hi {{customerName}},</p>
    <p>Your tickets for <strong>{{movieTitle}}</strong> have been booked successfully.</p>

    <table cellpadding="6" cellspacing="0" style="border-collapse: collapse;">
      <tr>
        <td><strong>Theater</strong></td>
        <td>{{theaterName}} - {{theaterLocation}}</td>
      </tr>
      <tr>
        <td><strong>Show Date &amp; Time</strong></td>
        <td>{{showDateTime}}</td>
      </tr>
      <tr>
        <td><strong>Seats</strong></td>
        <td>{{seatNumbers}}</td>
      </tr>
      <tr>
        <td><strong>Booking ID</strong></td>
        <td>{{bookingId}}</td>
      </tr>
      <tr>
        <td><strong>Payment Reference</strong></td>
        <td>{{maskedPaymentId}}</td>
      </tr>
      <tr>
        <td><strong>Amount Paid</strong></td>
        <td>{{amountPaid}}</td>
      </tr>
    </table>

    <p>Please show your booking ID at the theater entrance. Enjoy the movie!</p>
    <p style="font-size: 12px; color: #888;">
      This is an automated email, please do not reply. If you did not make this booking,
      contact our support team immediately.
    </p>
  </body>
</html>
